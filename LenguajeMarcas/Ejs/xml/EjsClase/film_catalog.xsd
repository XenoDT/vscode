<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
    targetNamespace="http://tierno.es/film_catalog"
    xmlns:tns="http://tierno.es/film_catalog"
    elementFormDefault="qualified">
    <xs:element name="catalog">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="movie" type="tns:TypeMovie" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>      
    </xs:element>
    <xs:complexType name="TypeMovie">
        <xs:sequence>
            <xs:element name="title"/>
            <xs:element name="year"/>
            <xs:element name="genre" maxOccurs="3"/>
            <xs:element name="rating" minOccurs="0"/>
            <xs:element name="director">
                <xs:complexType>
                    <xs:simpleContent>
                        <xs:extension base="xs:string">
                            <xs:attribute name="nationality"/>
                        </xs:extension>
                    </xs:simpleContent>
                </xs:complexType>
            </xs:element>
            <xs:element name="duration"/>
        </xs:sequence>
    </xs:complexType>
</xs:schema>